# ============================================================
# MMarchetti — .htaccess
# Hostinger / Apache
# ============================================================

# Disabilita listing directory
Options -Indexes -MultiViews

# Pagina di errore personalizzata
ErrorDocument 404 /404.html

# ============================================================
# REDIRECT HTTP → HTTPS + www → non-www
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www → non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ============================================================
# HEADER DI SICUREZZA
# ============================================================
<IfModule mod_headers.c>

  # HTTPS obbligatorio per 1 anno su tutti i sottodomini
  # ATTENZIONE: rimuovi "preload" finché non sei sicuro di restare sempre su HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Blocca clickjacking (il sito non può essere caricato in iframe)
  Header always set X-Frame-Options "DENY"

  # Blocca MIME-sniffing (il browser non indovina il tipo di file)
  Header always set X-Content-Type-Options "nosniff"

  # Invia referrer solo all'origine, solo su HTTPS
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disabilita accesso a camera, microfono, geolocalizzazione e altre API
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy
  # - script-src 'self'          → solo JS locale
  # - style-src 'self' 'unsafe-inline' → CSS locale + stili inline del cursore JS
  # - font-src 'self'            → font locali (nessuna chiamata a Google)
  # - img-src 'self' data:       → immagini locali + data URI
  # - form-action https://formspree.io → il form può inviare solo a Formspree
  # - frame-ancestors 'none'     → nessun iframe (più forte di X-Frame-Options)
  # - upgrade-insecure-requests  → le richieste HTTP vengono promosse ad HTTPS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests"

  # Nasconde informazioni sul server
  Header always unset X-Powered-By
  Header unset Server

</IfModule>

# ============================================================
# COMPRESSIONE GZIP
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================================
# CACHE BROWSER
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Immagini e font — cache 1 anno (cambiano raramente)
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"

  # CSS e JS — cache 1 mese
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType text/javascript   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML — cache 1 giorno (aggiornabile spesso)
  ExpiresByType text/html         "access plus 1 day"
</IfModule>

# ============================================================
# PROTEZIONI FILE SENSIBILI
# ============================================================
<FilesMatch "\.(htaccess|htpasswd|env|ini|log|sh|bak|sql|config)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Blocca accesso alla cartella _work
<IfModule mod_rewrite.c>
  RewriteRule ^_work/ - [F,L]
</IfModule>
